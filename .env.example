# Copy to .env.local and fill in values from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only: Sketchfab API token for the homepage hero model. Leave empty to always use the procedural laptop.
SKETCHFAB_API_KEY=your-sketchfab-api-token
